 version = "0.4.0"
 
 [features]
+# shlosilo vendor patch: exposes the raw extended-coordinate generator cache
+# serialize/reconstruct pair (to_raw_extended_bytes / from_raw_extended_bytes).
+generator-cache = []
+# shlosilo vendor patch: device perf-bench entry points (see src/perf_bench.rs).
+perf-bench = []
+# shlosilo vendor patch: force the CT-Straus core out-of-line (per-site
+# inline(never); the bp5 attribution says the sign path's instantiation
+# over-inlines into ~10 KB / 3 KB stack vs the bench's compact ~2.5 KB
+# shape, which runs faster). Opt-in; forgebox never activates it.
+straus-compact-codegen = []
+# shlosilo vendor patch (Z6 link-surface): transitional alloc fallback —
+# the large-count Vec MSM tails and the precomputed-straus machinery.
+# Zero-heap builds disable it; the small-count inline/scratch paths stay.
+alloc-fallback = []
 alloc = ["zeroize?/alloc"]
 default = [
     "alloc",
+    "alloc-fallback",
     "precomputed-tables",
     "zeroize",
 ]
