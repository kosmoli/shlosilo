+pub fn madd(iters: u32) -> u64 {
+    let table = LookupTable::<ProjectiveNielsPoint>::from(&ED25519_BASEPOINT_POINT);
+    let mut q = ED25519_BASEPOINT_POINT;
+    for i in 0..iters {
+        let d = ((i % 15) as i8) - 7;
