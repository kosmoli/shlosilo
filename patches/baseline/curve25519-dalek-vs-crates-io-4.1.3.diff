+    pub fn multiscalar_mul_scratch<I, J>(
+        scalars: I,
+        points: J,
+        scratch: &mut crate::scratch::StrausScratch,
+    ) -> Result<EdwardsPoint, crate::scratch::ScratchError>
+    where
+        I: IntoIterator,
+        I::Item: Borrow<Scalar>,
+        J: IntoIterator,
+        J::Item: Borrow<EdwardsPoint>,
+    {
