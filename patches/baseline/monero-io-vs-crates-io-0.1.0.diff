 /// Read a constant-length list of elements.
 pub fn read_array<R: Read, T: Debug, F: FnMut(&mut R) -> io::Result<T>, const N: usize>(
-  f: F,
+  mut f: F,
   r: &mut R,
 ) -> io::Result<[T; N]> {
-  read_raw_vec(f, N, r).map(|vec| {
-    vec.try_into().expect(
-      "read vector of specific length yet couldn't transform to an array of the same length",
-    )
-  })
+  // shlosilo vendor patch: fill the array in place (was read_raw_vec → Vec
+  // → try_into). The guard drops any partially-initialized prefix on
+  // error/panic paths.
+  use core::mem::MaybeUninit;
+  struct Guard<T, const N: usize> {
+    buf: [MaybeUninit<T>; N],
+    init: usize,
+  }
+  impl<T, const N: usize> Drop for Guard<T, N> {
+    fn drop(&mut self) {
+      for i in 0..self.init {
+        unsafe { self.buf[i].assume_init_drop() };
+      }
+    }
+  }
+  let mut g: Guard<T, N> = Guard {
+    buf: core::array::from_fn(|_| MaybeUninit::uninit()),
+    init: 0,
+  };
+  for i in 0..N {
+    g.buf[i].write(f(r)?);
+    g.init = i + 1;
+  }
+  let buf = unsafe {
+    let g = core::mem::ManuallyDrop::new(g);
+    core::ptr::read(&g.buf)
+  };
+  Ok(buf.map(|x| unsafe { x.assume_init() }))
 }
 
