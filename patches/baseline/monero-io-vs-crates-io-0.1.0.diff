+  use core::mem::MaybeUninit;
+  struct Guard<T, const N: usize> {
+    buf: [MaybeUninit<T>; N],
+    init: usize,
+  }
+  impl<T, const N: usize> Drop for Guard<T, N> {
+    fn drop(&mut self) {
+      for i in 0..self.init {
+        unsafe { self.buf[i].assume_init_drop() };
+      }
+    }
+  }
+  let mut g: Guard<T, N> = Guard {
+    buf: core::array::from_fn(|_| MaybeUninit::uninit()),
+    init: 0,
+  };
+  for i in 0..N {
+    g.buf[i].write(f(r)?);
+    g.init = i + 1;
+  }
+  let buf = unsafe {
+    let g = core::mem::ManuallyDrop::new(g);
+    core::ptr::read(&g.buf)
+  };
