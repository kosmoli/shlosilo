+                    .decompress()
+                    .map(|p| EdwardsPoint::mul_by_cofactor(&p.into()))
+                    .ok_or(IpError::InvalidPoint)?;
+                let R = R
+                    .decompress()
+                    .map(|p| EdwardsPoint::mul_by_cofactor(&p.into()))
+                    .ok_or(IpError::InvalidPoint)?;
+
+                verifier.0.other.push((verifier_weight * (x * x), L));
+                verifier
+                    .0
+                    .other
+                    .push((verifier_weight * (x_inv * x_inv), R));
+            }
