+          fn decompress_generator_vec(bytes: &[[u8; 32]]) -> std_shims::vec::Vec<curve25519_dalek::EdwardsPoint> {
+            let mut out = std_shims::vec::Vec::with_capacity(bytes.len());
+            for b in bytes {
+              out.push(
+                curve25519_dalek::edwards::CompressedEdwardsY(*b)
