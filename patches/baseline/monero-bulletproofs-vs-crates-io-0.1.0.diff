+        let mut new_g_bold = Vec::with_capacity(g_bold1.len());
+        let e_y_inv = e * y_inv_n_hat;
+        for g_bold in g_bold1.0.drain(..).zip(g_bold2.0.drain(..)) {
+            new_g_bold.push(multiexp_vartime_small(&[
+                (inv_e, g_bold.0),
+                (e_y_inv, g_bold.1),
