/target
proptest-regressions
__pycache__/
*.bin
*.elf
*.a
*.o
flux/host-sim/sim_l3
vendor/cryptonight/target
vendor/*/target
probes/*/target

# local audit artifacts (reports are not committed per project convention)
/功能核心整改*复审报告*.md
/HANDOFF-*.md
/XMR-BENCH-RUNBOOK-*.md

# sdk-gate: node dependencies are restored by `npm ci`, never committed
tools/sdk-gate/node_modules/
tools/ur-inject/node_modules/

# ccache's cache directory. CI puts it at the repo root (ccache-action sets
# CCACHE_DIR=$GITHUB_WORKSPACE/.ccache), and both firmware identity strings are derived from
# `git status --porcelain` — an untracked cache dir then reads as a dirty tree and the
# product footer wears "-dirty" for a clean commit (2026-11-26: that is exactly what happened,
# and the identity assertion in flux/forgebox/build.sh caught it on its first CI run).
/.ccache/

# Chain-axis matrix manifests are generated per run by scripts/check_chain_axes.sh in a
# temp dir (never in-tree) since batch 2: the matrix builds through
# scripts/build_declared.sh, and a limits profile carries no chain set any more. The
# pattern stays so a leftover from an older tree cannot be committed by accident.
/limits/chainaxes-*.toml

# Delivery receipts (scripts/build_declared.sh, role=delivery). A receipt describes one
# build of one working tree; committing one would publish a claim about a binary nobody
# can reproduce from the repository alone.
/build/receipts/
